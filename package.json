{
  "name": "ttrpg-log-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode singlefile",
    "test": "node --experimental-strip-types --test src/core.test.ts",
    "format": "prettier --write src index.html package.json tsconfig.json README.md .prettierrc.json",
    "format:check": "prettier --check src index.html package.json tsconfig.json README.md .prettierrc.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
